{
    "type": "tabs",
    "i18n": true,
    "items": {
        "_main": {
            "type": "panel",
            "label": "Main settings",
            "items": {
                "selectBy": {
                    "type": "select",
                    "label": "Select device by",
                    "options": [
                        {
                            "value": "port",
                            "label": "Serial port"
                        },
                        {
                            "value": "device",
                            "label": "USB device ID"
                        }
                    ],
                    "default": "port",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "serialPort": {
                    "newLine": true,
                    "type": "selectSendTo",
                    "label": "Serial port",
                    "command": "list",
                    "default": "",
                    "hidden": "data.selectBy === 'device'",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "serialPortDeviceId": {
                    "newLine": true,
                    "type": "selectSendTo",
                    "label": "USB device",
                    "help": "Identified by vendor and product ID, so the OS may reassign the port name",
                    "command": "listDevices",
                    "default": "",
                    "manual": true,
                    "noTranslation": true,
                    "hidden": "data.selectBy !== 'device'",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "baudRate": {
                    "newLine": true,
                    "type": "select",
                    "label": "Baud rate",
                    "noTranslation": true,
                    "options": [
                        {
                            "value": 4800,
                            "label": "4800"
                        },
                        {
                            "value": 9600,
                            "label": "9600"
                        },
                        {
                            "value": 19200,
                            "label": "19200"
                        },
                        {
                            "value": 38400,
                            "label": "38400"
                        },
                        {
                            "value": 57600,
                            "label": "57600"
                        },
                        {
                            "value": 115200,
                            "label": "115200"
                        }
                    ],
                    "default": "115200",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "_test": {
                    "newLine": true,
                    "type": "sendTo",
                    "command": "test",
                    "label": "Test",
                    "variant": "contained",
                    "jsonData": "{ \"serialPort\": \"${data.serialPort}\", \"serialPortDeviceId\": \"${data.serialPortDeviceId}\", \"selectBy\": \"${data.selectBy}\", \"baudRate\": \"${data.baudRate}\" }",
                    "result": {
                        "Sensor detected": {
                            "en": "Sensor detected",
                            "de": "Sensor erkannt",
                            "ru": "Сенсор обнаружен"
                        }
                    },
                    "error": {
                        "Sensor not detected": {
                            "en": "Sensor not detected",
                            "de": "Sensor nicht erkannt",
                            "ru": "Сенсор не обнаружен"
                        }
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "showProcess": true,
                    "icon": "send"
                },
                "_titleAccelerometer": {
                    "type": "header",
                    "text": "Accelerometer",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "accelerometer": {
                    "label": "Enabled",
                    "type": "checkbox",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "accelerometerUpdate": {
                    "label": "Minimum update interval",
                    "help": "ms",
                    "type": "number",
                    "default": 1000,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.accelerometer"
                },
                "accelerometerAverageInterval": {
                    "label": "Interval for average value",
                    "tooltip": "Time window for calculating the sliding average of sensor values",
                    "help": "ms",
                    "type": "number",
                    "default": 5000,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.accelerometer"
                },
                "_titleGyroscope": {
                    "type": "header",
                    "text": "Gyroscope",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "gyroscope": {
                    "label": "Enabled",
                    "type": "checkbox",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "gyroscopeUpdate": {
                    "label": "Minimum update interval",
                    "help": "ms",
                    "type": "number",
                    "default": 1000,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.gyroscope"
                },
                "agyroscopeAverageInterval": {
                    "label": "Interval for average value",
                    "tooltip": "Time window for calculating the sliding average of sensor values",
                    "help": "ms",
                    "type": "number",
                    "default": 5000,
                    "hidden": "!data.gyroscope",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "_headerMagnetometer": {
                    "type": "header",
                    "text": "Magnetometer",
                    "size": 4,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "magnetometer": {
                    "label": "Enabled",
                    "type": "checkbox",
                    "default": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "magnetometerUpdate": {
                    "label": "Minimum update interval",
                    "help": "ms",
                    "type": "number",
                    "default": 1000,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.magnetometer"
                },
                "magnetometerAverageInterval": {
                    "label": "Interval for average value",
                    "tooltip": "Time window for calculating the sliding average of sensor values",
                    "help": "ms",
                    "type": "number",
                    "default": 5000,
                    "hidden": "!data.magnetometer",
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2
                },
                "magnetometer360x": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Use 0-360° for angle X",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.magnetometer"
                },
                "magnetometer360y": {
                    "type": "checkbox",
                    "label": "Use 0-360° for angle Y",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.magnetometer"
                },
                "magnetometer360z": {
                    "type": "checkbox",
                    "label": "Use 0-360° for angle Z",
                    "default": false,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.magnetometer"
                },
                "magnetometerOffsetX": {
                    "newLine": true,
                    "type": "number",
                    "label": "Offset X",
                    "help": "°",
                    "default": 0,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.magnetometer"
                },
                "magnetometerOffsetY": {
                    "type": "number",
                    "label": "Offset Y",
                    "help": "°",
                    "default": 0,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.magnetometer"
                },
                "magnetometerOffsetZ": {
                    "type": "number",
                    "label": "Offset Z",
                    "help": "°",
                    "default": 0,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!data.magnetometer"
                }
            }
        },
        "_deviceManager": {
            "type": "panel",
            "label": "Device manager",
            "items": {
                "_dm": {
                    "type": "deviceManager",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "style": {
                        "width": "100%",
                        "height": "100%",
                        "overflow": "hidden"
                    }
                }
            }
        }
    }
}

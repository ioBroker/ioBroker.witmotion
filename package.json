{
    "name": "iobroker.witmotion",
    "description": "Read data from WitMotion sensor via USB for ioBroker",
    "version": "1.0.0",
    "author": "bluefox <dogafox@gmail.com>",
    "homepage": "https://github.com/ioBroker/ioBroker.witmotion",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.witmotion"
    },
    "keywords": [
        "ioBroker",
        "witmotion",
        "gyroscope"
    ],
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "serialport": "^13.0.0"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@iobroker/build-tools": "^3.0.1",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/legacy-testing": "^3.0.0",
        "@iobroker/testing": "^5.3.0",
        "@iobroker/types": "^7.2.2",
        "@tsconfig/node22": "^22.0.5",
        "@types/node": "^22.20.1",
        "typescript": "^6.0.3"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.witmotion/issues"
    },
    "main": "build/main.js",
    "files": [
        "admin/",
        "build/",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "prepublishOnly": "npm run build",
        "test:integration": "mocha test/adapter.test.js --exit",
        "test:package": "mocha test/package.test.js --exit",
        "test": "npm run test:integration",
        "lint": "eslint -c eslint.config.mjs",
        "build": "tsc -p tsconfig.build.json && node tasks",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "update-packages": "npx -y npm-check-updates --upgrade && cd src-devices && npx -y npm-check-updates --upgrade",
        "npm": "npm i && cd src-devices && npm i -f"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "license": "MIT"
}
